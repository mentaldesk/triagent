<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Triagent</RootNamespace>
    <AssemblyName>triagent</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>triagent</ToolCommandName>
    <PackageId>Triagent</PackageId>
    <Description>Score GitHub issues for AI-agent doability and keep the results in a local SQLite database so the analysis stays incremental.</Description>
    <Authors>mentaldesk</Authors>
    <PackageProjectUrl>https://github.com/mentaldesk/triagent</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mentaldesk/triagent</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Triagent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Octokit" Version="13.0.1" />
    <PackageReference Include="Octokit.GraphQL" Version="0.4.0-beta" />
    <PackageReference Include="Sentry" Version="5.16.1" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="System.CommandLine" Version="2.0.7" />
    <PackageReference Include="Terminal.Gui" Version="2.0.0-rc.1" />
  </ItemGroup>

</Project>
